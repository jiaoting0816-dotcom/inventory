{
  "name": "merch-inventory",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "merch-inventory",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "merch-inventory-images"
    }
  ]
}
